{
  "name": "headscale-web",
  "version": "0.11.9",
  "description": "Web interface for headscale 0.28.0",
  "homepage": "https://itsib.su",
  "license": "MIT",
  "author": {
    "email": "itsib.su@gmail.com",
    "name": "Sergey Kraynow"
  },
  "config": {
    "name": "Headscale Web UI",
    "short-name": "Headscale Web",
    "theme-color": "rgb(31 30 30)",
    "background-color": "rgb(31 30 30)"
  },
  "private": false,
  "type": "module",
  "browser": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsib/headscale-web.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "build": "npm run build:icons && tsc -b && NODE_ENV=production vite build --mode production && npm run build:copy",
    "build:dev": "tsc -b && NODE_ENV=development vite build --mode development && npm run build:copy",
    "build:icons": "icon-font g",
    "build:copy": "node ./scripts/copy.mjs",
    "lint": "eslint . && prettier --log-level warn --check .",
    "lint:fix": "prettier --log-level warn --write . && eslint . --fix",
    "test": "vitest",
    "preview": "vite preview",
    "preversion": "npm run lint && npm run test",
    "version": "node ./scripts/version.mjs && git add .",
    "postversion": "git push && git push --tags"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-just-ui": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@itsib/icon-font": "^0.4.14",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-nested": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {},
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true
  }
}
